#!/usr/bin/env bash
# Serve the built app (dist/) on 127.0.0.1. Static files only; build with `npm run build`.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
port=31741
[ "${1:-}" = "--port" ] && port="$2"
[ -f "$here/dist/index.html" ] || { echo "no build in $here/dist: run npm run build" >&2; exit 1; }
exec python3 -I "$here/packaging/serve.py" --port "$port" --dir "$here/dist"
